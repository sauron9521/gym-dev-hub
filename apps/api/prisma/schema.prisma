generator client {
  provider = "prisma-client"
  output   = "../.local/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Issue #37: versioned records only; authenticated read/write routes remain disabled.
// This database is not gym-platform and has no schema overlap with it.

// Repo entries are explicitly provisioned by a trusted operator; never
// inferred from agent-supplied notes. Composite relations forbid cross-tenant IDs.
enum MemoryKind {
  FACT
  DECISION
  CONSTRAINT
  PROPOSAL
}

enum MemoryStatus {
  PROPOSED
  VERIFIED
  SUPERSEDED
  REVOKED
}

enum MemoryScope {
  PROJECT
  TASK
  SESSION
}

enum MemorySourceType {
  GITHUB
  WORKSPACE
  HUMAN
  AGENT
}

model MemoryRepository {
  name             String                   @id @db.VarChar(200)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  tasks            MemoryTask[]
  agents           MemoryAgentIdentity[]
  sessions         MemorySession[]
  records          MemoryRecord[]
  proposalRequests MemoryProposalRequest[]
  mutationAudits   MemoryMutationAudit[]
  operators        MemoryOperatorIdentity[]

  @@map("memory_repositories")
}

// Distinct, role-scoped local operator credentials, never plaintext secrets.
// These are credential-holder identities, not proof of a unique natural person.
model MemoryOperatorIdentity {
  id             String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repository     String                        @db.VarChar(200)
  handle         String                        @db.VarChar(48)
  role           String                        @db.VarChar(16)
  tokenDigest    String                        @unique @map("token_digest") @db.Char(64)
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime                      @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?                     @map("revoked_at") @db.Timestamptz(3)
  project        MemoryRepository              @relation(fields: [repository], references: [name], onUpdate: Restrict, onDelete: Restrict)
  audits         MemoryOperatorIdentityAudit[]
  mutationAudits MemoryMutationAudit[]

  @@unique([repository, handle])
  @@unique([repository, id])
  @@index([repository, role, expiresAt])
  @@map("memory_operator_identities")
}

model MemoryOperatorIdentityAudit {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repository String                 @db.VarChar(200)
  operatorId String                 @map("operator_id") @db.Uuid
  action     String                 @db.VarChar(16)
  actor      String                 @default("bootstrap-root") @db.VarChar(32)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  operator   MemoryOperatorIdentity @relation(fields: [repository, operatorId], references: [repository, id], onUpdate: Restrict, onDelete: Restrict)

  @@index([repository, operatorId, createdAt])
  @@map("memory_operator_identity_audit")
}

model MemoryTask {
  id             String                @id @default(uuid()) @db.Uuid
  repository     String                @db.VarChar(200)
  externalRef    String                @map("external_ref") @db.VarChar(255)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  project        MemoryRepository      @relation(fields: [repository], references: [name], onDelete: Restrict, onUpdate: Restrict)
  records        MemoryRecord[]
  sessions       MemorySession[]
  mutationAudits MemoryMutationAudit[]

  @@unique([repository, id])
  @@unique([repository, externalRef])
  @@index([repository, createdAt])
  @@map("memory_tasks")
}

model MemoryAgentIdentity {
  id               String                  @id @default(uuid()) @db.Uuid
  repository       String                  @db.VarChar(200)
  externalRef      String                  @map("external_ref") @db.VarChar(255)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  project          MemoryRepository        @relation(fields: [repository], references: [name], onDelete: Restrict, onUpdate: Restrict)
  records          MemoryRecord[]
  sessions         MemorySession[]
  proposalRequests MemoryProposalRequest[]
  mutationAudits   MemoryMutationAudit[]

  @@unique([repository, id])
  @@unique([repository, externalRef])
  @@map("memory_agent_identities")
}

model MemorySession {
  id               String                  @id @default(uuid()) @db.Uuid
  repository       String                  @db.VarChar(200)
  externalRef      String                  @map("external_ref") @db.VarChar(255)
  taskId           String?                 @map("task_id") @db.Uuid
  agentId          String?                 @map("agent_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  project          MemoryRepository        @relation(fields: [repository], references: [name], onDelete: Restrict, onUpdate: Restrict)
  task             MemoryTask?             @relation(fields: [repository, taskId], references: [repository, id], onDelete: Restrict, onUpdate: Restrict)
  agent            MemoryAgentIdentity?    @relation(fields: [repository, agentId], references: [repository, id], onDelete: Restrict, onUpdate: Restrict)
  records          MemoryRecord[]
  proposalRequests MemoryProposalRequest[]
  mutationAudits   MemoryMutationAudit[]

  @@unique([repository, id])
  @@unique([repository, externalRef])
  @@index([repository, taskId])
  @@map("memory_sessions")
}

model MemoryRecord {
  id               String                  @id @default(uuid()) @db.Uuid
  repository       String                  @db.VarChar(200)
  scope            MemoryScope
  kind             MemoryKind
  status           MemoryStatus            @default(PROPOSED)
  text             String                  @db.VarChar(4096)
  revision         Int                     @default(1)
  taskId           String?                 @map("task_id") @db.Uuid
  sessionId        String?                 @map("session_id") @db.Uuid
  agentId          String?                 @map("agent_id") @db.Uuid
  sourceSha        String?                 @map("source_sha") @db.VarChar(40)
  expiresAt        DateTime?               @map("expires_at") @db.Timestamptz(3)
  verifiedBy       String?                 @map("verified_by") @db.VarChar(200)
  verifiedAt       DateTime?               @map("verified_at") @db.Timestamptz(3)
  supersededById   String?                 @map("superseded_by_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  project          MemoryRepository        @relation(fields: [repository], references: [name], onDelete: Restrict, onUpdate: Restrict)
  task             MemoryTask?             @relation(fields: [repository, taskId], references: [repository, id], onDelete: Restrict, onUpdate: Restrict)
  session          MemorySession?          @relation(fields: [repository, sessionId], references: [repository, id], onDelete: Restrict, onUpdate: Restrict)
  agent            MemoryAgentIdentity?    @relation(fields: [repository, agentId], references: [repository, id], onDelete: Restrict, onUpdate: Restrict)
  supersededBy     MemoryRecord?           @relation("MemorySupersession", fields: [repository, supersededById], references: [repository, id], onDelete: Restrict, onUpdate: Restrict)
  supersedes       MemoryRecord[]          @relation("MemorySupersession")
  sources          MemorySource[]
  revisions        MemoryRevision[]
  proposalRequests MemoryProposalRequest[]
  mutationAudits   MemoryMutationAudit[]

  @@unique([repository, id])
  @@index([repository, scope, taskId, kind, status, updatedAt])
  @@index([repository, scope, sessionId, updatedAt])
  @@index([repository, status, expiresAt])
  @@map("memory_records")
}

// Provenance is anchored in the same repository and memory as the record.
model MemorySource {
  id         String           @id @default(uuid()) @db.Uuid
  repository String           @db.VarChar(200)
  memoryId   String           @map("memory_id") @db.Uuid
  sourceType MemorySourceType @map("source_type")
  actorId    String           @map("actor_id") @db.VarChar(200)
  sourceRef  String           @map("source_ref") @db.VarChar(512)
  sourceSha  String?          @map("source_sha") @db.VarChar(40)
  observedAt DateTime         @map("observed_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  record     MemoryRecord     @relation(fields: [repository, memoryId], references: [repository, id], onDelete: Restrict, onUpdate: Restrict)
  revisions  MemoryRevision[]

  @@unique([repository, memoryId, id])
  @@index([repository, memoryId, observedAt])
  @@map("memory_sources")
}

// Immutable snapshots are populated by DB triggers, not agent-provided APIs.
model MemoryRevision {
  id         String        @id @default(uuid()) @db.Uuid
  repository String        @db.VarChar(200)
  memoryId   String        @map("memory_id") @db.Uuid
  revision   Int
  scope      MemoryScope
  kind       MemoryKind
  status     MemoryStatus
  text       String        @db.VarChar(4096)
  sourceSha  String?       @map("source_sha") @db.VarChar(40)
  sourceId   String?       @map("source_id") @db.Uuid
  changedBy  String        @map("changed_by") @db.VarChar(200)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  record     MemoryRecord  @relation(fields: [repository, memoryId], references: [repository, id], onDelete: Restrict, onUpdate: Restrict)
  source     MemorySource? @relation(fields: [repository, memoryId, sourceId], references: [repository, memoryId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([repository, memoryId, revision])
  @@index([repository, memoryId, createdAt])
  @@map("memory_revisions")
}

// Idempotency is unique per registered agent/session, not a caller-supplied actor.
model MemoryProposalRequest {
  repository    String              @db.VarChar(200)
  agentId       String              @map("agent_id") @db.Uuid
  sessionId     String              @map("session_id") @db.Uuid
  requestKey    String              @map("request_key") @db.Uuid
  payloadDigest String              @map("payload_digest") @db.Char(64)
  memoryId      String              @map("memory_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  project       MemoryRepository    @relation(fields: [repository], references: [name], onDelete: Restrict, onUpdate: Restrict)
  agent         MemoryAgentIdentity @relation(fields: [repository, agentId], references: [repository, id], onDelete: Restrict, onUpdate: Restrict)
  session       MemorySession       @relation(fields: [repository, sessionId], references: [repository, id], onDelete: Restrict, onUpdate: Restrict)
  record        MemoryRecord        @relation(fields: [repository, memoryId], references: [repository, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([repository, agentId, sessionId, requestKey])
  @@unique([repository, memoryId])
  @@map("memory_proposal_requests")
}

// Metadata-only append-only transaction audit, no raw text, secrets or prompts.
model MemoryMutationAudit {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repository         String                  @db.VarChar(200)
  memoryId           String                  @map("memory_id") @db.Uuid
  agentId            String                  @map("agent_id") @db.Uuid
  taskId             String                  @map("task_id") @db.Uuid
  sessionId          String                  @map("session_id") @db.Uuid
  action             String                  @db.VarChar(40)
  previousDigest     String?                 @map("previous_digest") @db.Char(64)
  resultingDigest    String                  @map("resulting_digest") @db.Char(64)
  operatorActorId    String?                 @map("operator_actor_id") @db.VarChar(80)
  operatorIdentityId String?                 @map("operator_identity_id") @db.Uuid
  operatorIdentity   MemoryOperatorIdentity? @relation(fields: [repository, operatorIdentityId], references: [repository, id], onDelete: Restrict, onUpdate: Restrict)
  grantId            String?                 @map("grant_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  project            MemoryRepository        @relation(fields: [repository], references: [name], onDelete: Restrict, onUpdate: Restrict)
  agent              MemoryAgentIdentity     @relation(fields: [repository, agentId], references: [repository, id], onDelete: Restrict, onUpdate: Restrict)
  task               MemoryTask              @relation(fields: [repository, taskId], references: [repository, id], onDelete: Restrict, onUpdate: Restrict)
  session            MemorySession           @relation(fields: [repository, sessionId], references: [repository, id], onDelete: Restrict, onUpdate: Restrict)
  record             MemoryRecord            @relation(fields: [repository, memoryId], references: [repository, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([repository, memoryId, createdAt])
  @@index([repository, operatorIdentityId, createdAt])
  @@map("memory_mutation_audit")
}
