# Comma-separated allowlist of repositories visible to this local instance.
GITHUB_REPOSITORIES=sauron9521/gym-dev-hub,sauron9521/gym-platform

# Optional. Public repositories work without a token but GitHub rate-limits
# unauthenticated API requests. Use a fine-grained read-only token locally.
# GITHUB_TOKEN=github_pat_your_read_only_token
