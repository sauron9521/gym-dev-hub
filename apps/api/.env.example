# Comma-separated allowlist of repositories visible to this local instance.
GITHUB_REPOSITORIES=sauron9521/gym-dev-hub,sauron9521/gym-platform

# Optional paths for local Git repository discovery and planned worktrees.
# DEV_HUB_REPOS_ROOT=F:\\programer
# DEV_HUB_WORKTREES_ROOT=F:\\programer\\gym-dev-hub\\apps\\api\\.local\\worktrees
# DEV_HUB_PLAN_FILE=F:\\programer\\gym-dev-hub\\apps\\api\\.local\\worktree-plans.json

# Optional path to the native Codex binary (absolute path, not a shell script).
# CODEX_EXECUTABLE=C:\\path\\to\\codex.exe

# Optional. Public repositories work without a token but GitHub rate-limits
# unauthenticated API requests. Use a fine-grained read-only token locally.
# GITHUB_TOKEN=github_pat_your_read_only_token
