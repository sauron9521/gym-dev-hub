# Comma-separated allowlist of repositories visible to this local instance.
GITHUB_REPOSITORIES=sauron9521/gym-dev-hub,sauron9521/gym-platform

# Optional paths for local Git repository discovery and planned worktrees.
# DEV_HUB_REPOS_ROOT=F:\\programer
# DEV_HUB_WORKTREES_ROOT=F:\\programer\\gym-dev-hub\\apps\\api\\.local\\worktrees
# DEV_HUB_PLAN_FILE=F:\\programer\\gym-dev-hub\\apps\\api\\.local\\worktree-plans.json

# PR #10: disabled by default. Requires a random secret >= 32 characters.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# DEV_HUB_ENABLE_WORKTREE_CREATION=true
# PR #13: independent explicit switch; never enabled automatically.
# DEV_HUB_ENABLE_WORKTREE_HYDRATION=true
# PR #15: independently opt in to an ephemeral read-only Docker mount probe.
# This does NOT enable Codex or agent commands.
# DEV_HUB_ENABLE_WORKTREE_MOUNT=true
# PR #16: extra opt-in, one file per single-use read grant, no arbitrary commands.
# DEV_HUB_ENABLE_SCOPED_CODE_READ=true
# DEV_HUB_WORKTREE_OPERATOR_SECRET=your_random_local_operator_secret
# PR #17: fixed SHA-256 worker tool; independent opt-in and separate secret.
# DEV_HUB_ENABLE_WORKER_TOOLS=true
# DEV_HUB_WORKER_TOOL_SECRET=another_independent_random_32_byte_secret
# PR #18: independent opt-in; short-lived one-file snapshot from pinned Git object.
# DEV_HUB_ENABLE_PINNED_FILE_STAGE=true

# Optional path to the native Codex binary (absolute path, not a shell script).
# CODEX_EXECUTABLE=C:\\path\\to\\codex.exe

# Optional. Public repositories work without a token but GitHub rate-limits
# unauthenticated API requests. Use a fine-grained read-only token locally.
# GITHUB_TOKEN=github_pat_your_read_only_token

# Shared Agent Memory (#36): disabled unless explicitly enabled on the local Hub.
# Generate a unique password locally; do not commit it or place it in chat.
# DEV_HUB_MEMORY_ENABLE=false
# DEV_HUB_MEMORY_DB_PASSWORD=<your-private-random-password>
# DEV_HUB_MEMORY_DB_PORT=55441
# DEV_HUB_MEMORY_DATABASE_URL=postgresql://gym_dev_hub:<same-private-password>@127.0.0.1:55441/gym_dev_hub_memory
# DEV_HUB_MEMORY_TEST_DATABASE_URL=postgresql://gym_dev_hub:<test-only-password>@127.0.0.1:55441/gym_dev_hub_memory_test

# Shared Memory control plane (#39): independent, disabled by default.
# No memory HTTP routes become accessible merely from these flags.
# Generate a fresh random operator secret; NEVER reuse Git/worktree/worker secrets.
# DEV_HUB_MEMORY_SECURITY_ENABLE=false
# DEV_HUB_MEMORY_OPERATOR_SECRET=<new-private-random-32-byte-secret>
# DEV_HUB_MEMORY_ALLOWED_REPOSITORIES=sauron9521/gym-dev-hub
# DEV_HUB_MEMORY_TRUSTED_ORIGIN=http://127.0.0.1:3100
# DEV_HUB_MEMORY_EXTERNAL_READ_ENABLE=false
# Local HTTP memory reads require fully session-bound agent credentials.
# External/MCP read credentials are never accepted on these HTTP routes.
# Verified memory list reads require a THIRD independent opt-in switch.
# A valid operator/agent credential alone never enables read routes.
# DEV_HUB_MEMORY_READ_HTTP_ENABLE=false
# Extra opt-in; agent read tokens never grant proposals, approval or mutation.
# PROPOSE_MEMORY agent tokens require bound repository/task/session and operator issuance.
# DEV_HUB_MEMORY_PROPOSALS_HTTP_ENABLE=false
# Two-step, local operator approval is separately opt-in and default-off.
# DEV_HUB_MEMORY_APPROVAL_HTTP_ENABLE=false
# Independent opt-in for PROPOSED -> REVOKED (not VERIFIED revocation).
# DEV_HUB_MEMORY_REJECTION_HTTP_ENABLE=false
# Independent operator-only verified revocation; never available to agents.
# DEV_HUB_MEMORY_VERIFIED_REVOCATION_HTTP_ENABLE=false
# Independent local operator-only VERIFIED-to-VERIFIED supersession (one predecessor).
# DEV_HUB_MEMORY_SUPERSEDE_HTTP_ENABLE=false
# Individually scoped local operator credentials: default off; no approvals until later PR.
# DEV_HUB_MEMORY_OPERATOR_IDENTITIES_HTTP_ENABLE=false
