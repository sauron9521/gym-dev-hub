{
  "name": "gym-dev-hub",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:operator": "node scripts/dev-operator.mjs",
    "memory:db:up": "docker compose --env-file apps/api/.env -f compose.memory.yml up -d --wait",
    "memory:db:down": "docker compose --env-file apps/api/.env -f compose.memory.yml down",
    "memory:db:generate": "pnpm --filter @gym-dev-hub/api db:generate",
    "memory:db:status": "pnpm --filter @gym-dev-hub/api db:status",
    "memory:db:health": "pnpm --filter @gym-dev-hub/api db:health",
    "memory:db:migrate": "pnpm --filter @gym-dev-hub/api db:migrate",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test packages/runner/patch-checks-local.test.mjs scripts/prepare-patch-check-store.test.mjs scripts/nest-watch-fs-probe.test.mjs scripts/nest-watch-compiler-marker.test.mjs scripts/dev-operator.test.mjs scripts/launch-source-reconcile.test.mjs scripts/launch-fixed-docker-smoke.test.mjs scripts/launch-sigkill-recovery-smoke.test.mjs scripts/launch-live-operator-readiness.test.mjs scripts/launch-source-owner-backup.test.mjs scripts/launch-owner-fast-forward.test.mjs",
    "diagnose:nest-watch": "node scripts/diagnose-nest-watch.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "provision:patch-check-store": "node scripts/prepare-patch-check-store.mjs --prepare",
    "provision:patch-check-store:verify": "node scripts/prepare-patch-check-store.mjs --verify",
    "provision:pinned-api": "node scripts/provision-pinned-api-local.mjs --prepare",
    "provision:verify": "node scripts/provision-pinned-api-local.mjs --verify",
    "test:local-provisioner": "node --test scripts/provision-pinned-api-local.test.mjs",
    "provision:status": "node scripts/pinned-provision-recovery.mjs --status",
    "provision:cleanup-stale": "node scripts/pinned-provision-recovery.mjs --prune-stale",
    "test:provision-recovery": "node --test scripts/pinned-provision-recovery.test.mjs",
    "test:stage-ledger": "node --test scripts/pinned-stage-ledger.test.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.13",
    "typescript": "^6.0.0",
    "oxlint": "^1.0.0"
  }
}
