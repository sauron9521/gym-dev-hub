{
  "name": "gym-dev-hub",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "provision:pinned-api": "node scripts/provision-pinned-api-local.mjs --prepare",
    "test:local-provisioner": "node --test scripts/provision-pinned-api-local.test.mjs",
    "provision:status": "node scripts/pinned-provision-recovery.mjs --status",
    "provision:cleanup-stale": "node scripts/pinned-provision-recovery.mjs --prune-stale",
    "test:provision-recovery": "node --test scripts/pinned-provision-recovery.test.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.13",
    "typescript": "^6.0.0",
    "oxlint": "^1.0.0"
  }
}
